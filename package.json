{
  "name": "tokenlens",
  "version": "0.1.0",
  "author": "Joan Sterjo",
  "description": "A design token studio inside Chrome DevTools.",
  "repository": { "type": "git", "url": "https://github.com/joansterjo/tokenlens.git" },
  "homepage": "https://joansterjo.github.io/tokenlens/",
  "bugs": { "url": "https://github.com/joansterjo/tokenlens/issues" },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "site:build": "node scripts/build-site.mjs",
    "site:preview": "pnpm site:build && python3 -m http.server 4176 --bind 127.0.0.1 --directory .site-dist",
    "build": "tsc --noEmit && vite build",
    "build:store": "tsc --noEmit && vite build --mode store && node scripts/package-store.mjs",
    "package": "pnpm build && pnpm size-limit && pnpm build:store && python3 scripts/package-release.py",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test scripts",
    "test": "vitest run --project node",
    "test:browser": "vitest run --project browser",
    "test:e2e": "playwright test",
    "test:perf": "playwright test test/perf",
    "size-limit": "node scripts/check-size.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm size-limit"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "culori": "4.0.2",
    "lucide-react": "0.468.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "2.7.1",
    "@vitejs/plugin-react": "4.7.0",
    "vite": "6.4.1",
    "typescript": "5.9.3",
    "@types/chrome": "0.1.24",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/node": "22.19.1",
    "@types/culori": "4.0.1",
    "vitest": "4.0.18",
    "@vitest/browser-playwright": "4.0.18",
    "@playwright/test": "1.58.2",
    "eslint": "9.39.1",
    "typescript-eslint": "8.48.1",
    "@eslint/js": "9.39.1",
    "globals": "16.5.0",
    "fast-check": "4.3.0",
    "pngjs": "7.0.0",
    "@types/pngjs": "6.0.5"
  }
}
